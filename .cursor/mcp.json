{
    "mcpServers": {
        "gortex": {
            "args": [
                "mcp"
            ],
            "command": "gortex",
            "env": {
                "GORTEX_INDEX_WORKERS": "8"
            }
        },
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        }
    }
}